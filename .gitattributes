# Normalize line endings in the repository
* text=auto

# Windows scripts must keep CRLF, Unix scripts must keep LF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
gradlew text eol=lf
*.sh text eol=lf

# Binary files
*.jar binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
